# Server only. The application host injects this into /decisions; key presence
# alone does not establish account/model eligibility or permission to spend.
TYPESAFE_API_KEY=

# Optional development tooling preference. Never a production access grant.
GPT_IMAGE_ACCESS_MODE=codex_subscription
# No image execution model is selected by this harness. The deployed studio
# reads TICKETSTUB_ART_MODEL; GPT_IMAGE_MODEL is its direct-OpenAI migration alias.

# Neatlogs (see docs/runbooks/neatlogs.md). Loaded only when a command passes
# `--env-file .env`; deployments inject these from server secret storage.
# Project ingest key (OTLP `x-api-key`). It does not authorize Public API reads.
NEATLOGS_INGEST_KEY=
# Service-account Public API token (Bearer) with observability:read, bound to
# NEATLOGS_PROJECT_ID. Used only for readback verification.
NEATLOGS_READ_TOKEN=
# UUID of the Neatlogs project the token is bound to (sent as `x-project-id`).
NEATLOGS_PROJECT_ID=
# Region pair. Leave blank for US; for EU use https://eu.ingest.neatlogs.com
# and https://eu.app.neatlogs.com together. Credentials are region-bound.
NEATLOGS_ENDPOINT=
NEATLOGS_HOST=
# Server-held HMAC key for TicketStub hand-off tokens: 64 to 128 lowercase hex
# characters (32 to 64 random bytes), e.g. `openssl rand -hex 32`. Required only
# by a host that runs the TicketStub exporter. Rotating it starts new sessions.
AGENT_HARNESS_TELEMETRY_KEY=
